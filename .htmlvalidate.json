{
  "extends": ["html-validate:recommended", "html-validate:document"],
  "rules": {
    "void-style": [
      "error",
      {
        "style": "selfclosing"
      }
    ],
    "no-trailing-whitespace": "error",
    "doctype-style": [
      "error",
      {
        "style": "lowercase"
      }
    ],
    "require-sri": "off",
    "script-type": "off",
    "no-inline-style": "off"
  }
}
