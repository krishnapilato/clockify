{
  "name": "clockify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A simple and elegant clock with world clocks, an alarm, a stopwatch and a countdown.",
  "engines": {
    "node": ">=26.13"
  },
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "lint:html": "html-validate \"*.html\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "unused": "knip --treat-config-hints-as-errors",
    "test": "vitest run --coverage",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run lint:styles && npm run lint:html && npm run unused && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "gsap": "3.15.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "html-validate": "11.19.0",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "sass": "1.108.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
